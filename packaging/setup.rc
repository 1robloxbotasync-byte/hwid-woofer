// Setup icon and metadata. The payload files themselves live in
// obj\setup_payload.rc, generated by build.ps1 with absolute paths, so this
// file never has to guess where the build output is.
#define IDI_SETUPICON 1

#include "..\shared\version.h"

IDI_SETUPICON ICON "../user/app.ico"

1 VERSIONINFO
 FILEVERSION HWID_VERSION_MAJOR,HWID_VERSION_MINOR,HWID_VERSION_PATCH,0
 PRODUCTVERSION HWID_VERSION_MAJOR,HWID_VERSION_MINOR,HWID_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", HWID_COMPANY_NAME
            VALUE "FileDescription", "HWID Spoofer Setup"
            VALUE "FileVersion", HWID_VERSION_STRING
            VALUE "InternalName", "hwidspoof-setup"
            VALUE "LegalCopyright", HWID_COPYRIGHT
            VALUE "OriginalFilename", "hwidspoof-setup.exe"
            VALUE "ProductName", HWID_PRODUCT_NAME
            VALUE "ProductVersion", HWID_VERSION_STRING
            VALUE "Comments", HWID_TAGLINE
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

STRINGTABLE
BEGIN
    1 "HWID Spoofer Setup"
    2 "Installs HWID Spoofer, its command line build and the driver image."
END
