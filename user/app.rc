// Explorer / taskbar icon. The window falls back to a drawn badge if this is
// ever stripped, so the id only has to match gui.cpp.
#define IDI_APPICON 1

#include "..\shared\version.h"

IDI_APPICON ICON "app.ico"

/*
 * Explorer's Details tab, Add/Remove Programs and every scanning engine read
 * these fields. A signed image with no version resource still looks like a
 * packed payload; this is the cheapest thing a binary can do to look like a
 * program.
 */
1 VERSIONINFO
 FILEVERSION HWID_VERSION_MAJOR,HWID_VERSION_MINOR,HWID_VERSION_PATCH,0
 PRODUCTVERSION HWID_VERSION_MAJOR,HWID_VERSION_MINOR,HWID_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", HWID_COMPANY_NAME
            VALUE "FileDescription", "HWID Spoofer"
            VALUE "FileVersion", HWID_VERSION_STRING
            VALUE "InternalName", "hwidspoof"
            VALUE "LegalCopyright", HWID_COPYRIGHT
            VALUE "OriginalFilename", "hwidspoof.exe"
            VALUE "ProductName", HWID_PRODUCT_NAME
            VALUE "ProductVersion", HWID_VERSION_STRING
            VALUE "Comments", HWID_TAGLINE
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
