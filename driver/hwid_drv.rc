// Driver image metadata. A .sys with no version resource is one of the
// strongest single signals an engine has; every shipping Microsoft driver
// carries one.
#define IDI_DRVICON 2

#include "..\shared\version.h"

IDI_DRVICON ICON "../user/app.ico"

1 VERSIONINFO
 FILEVERSION HWID_VERSION_MAJOR,HWID_VERSION_MINOR,HWID_VERSION_PATCH,0
 PRODUCTVERSION HWID_VERSION_MAJOR,HWID_VERSION_MINOR,HWID_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x3L
 FILESUBTYPE 0x5L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", HWID_COMPANY_NAME
            VALUE "FileDescription", "HWID Spoofer storage filter driver"
            VALUE "FileVersion", HWID_VERSION_STRING
            VALUE "InternalName", "storhlp"
            VALUE "LegalCopyright", HWID_COPYRIGHT
            VALUE "OriginalFilename", "storhlp.sys"
            VALUE "ProductName", HWID_PRODUCT_NAME
            VALUE "ProductVersion", HWID_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
